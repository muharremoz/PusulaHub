<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PUSULA CONNECT 2 — müşterinin bağlantı uygulaması (VPN + RDP). Konsept: docs/pusula-connect/KONSEPT.md
    İskelet Aktarım 2 (apps/aktarim-istemci) ile aynı:
    penceresiz exe → yalnız 127.0.0.1'i dinleyen küçük web sunucusu → WebView2 penceresi.
    Arayüz (../../web, React + Vite) derlenip exe'ye gömülür; Costura ile tek dosya.

    Derleme:
      1) apps/connect-istemci/web:  npm install && npm run build
      2) bu klasörde:               dotnet build -c Release
    (2. adım web/dist yoksa 1. adımı kendisi çalıştırır.)
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 64 bit çalışsın: 32 bit süreçte Windows "Program Files" ve HKLM SOFTWARE yollarını
         WOW6432Node görünümüne yönlendirir → FortiClient görünmez, VPN profili yanlış yere
         yazılır (2026-10-01 yerel denemede yakalandı). -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PusulaConnect</AssemblyName>
    <RootNamespace>PusulaConnect</RootNamespace>
    <!-- Servisteki MIN_ISTEMCI_SURUM ile karşılaştırılır (eskiyse 426); kendini güncelleme istemci/surum.txt ile. -->
    <Version>0.3.5</Version>
    <Company>Pusula Yazılım</Company>
    <Product>Pusula Connect</Product>
    <AssemblyTitle>Pusula Connect</AssemblyTitle>
    <Description>Pusula Connect — Pusula sunucularına bağlantı</Description>
    <Copyright>© Pusula Yazılım</Copyright>
    <ApplicationIcon>uygulama.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <DebugType>embedded</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WebKlasoru>$(MSBuildThisFileDirectory)..\..\web\</WebKlasoru>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <!-- ProtectedData (DPAPI) — oturum tokenı yalnız bu Windows kullanıcısına açık saklanır -->
    <Reference Include="System.Security" />
    <!-- Konum yönlendirme (GeoCoordinateWatcher → SendLocation2D) -->
    <Reference Include="System.Device" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Gömülü uzak masaüstü (OturumPaneli): Windows'un mstscax.dll'inden AxImp ile üretildi
         ("NETFX 4.8 Tools\x64\AxImp.exe C:\Windows\System32\mstscax.dll"). Costura exe'ye gömer. -->
    <Reference Include="MSTSCLib"><HintPath>lib\MSTSCLib.dll</HintPath></Reference>
    <Reference Include="AxMSTSCLib"><HintPath>lib\AxMSTSCLib.dll</HintPath></Reference>
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.8.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Derlenmiş web arayüzü exe'ye gömülür: kaynak adı = "web/" + göreli yol. -->
  <ItemGroup>
    <EmbeddedResource Include="$(WebKlasoru)dist\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Oturum şeridindeki logo -->
    <EmbeddedResource Include="$(WebKlasoru)src\assets\pusula-logo.png" LogicalName="logo.png" />
    <!-- Pusula X yazıcı ajanı (PusulaX deposundan derlenmiş, .NET 4.8) — Ayarlar'dan kurulur; bkz. YaziciAjani.cs -->
    <EmbeddedResource Include="lib\PusulaXPrintAgent.exe" LogicalName="yazici-ajani/PusulaXPrintAgent.exe" />
  </ItemGroup>

  <Target Name="WebArayuzuDerle" BeforeTargets="BeforeBuild" Condition="!Exists('$(WebKlasoru)dist\index.html')">
    <Message Importance="high" Text="Web arayüzü derleniyor (connect-istemci/web)…" />
    <Exec Command="npm install" WorkingDirectory="$(WebKlasoru)" Condition="!Exists('$(WebKlasoru)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebKlasoru)" />
    <ItemGroup>
      <EmbeddedResource Include="$(WebKlasoru)dist\**\*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!-- WebView2'nin yerel yükleyicisi exe'ye gömülür (tek dosya); ConnectPenceresi çıkarır. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="webview2/x64/WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" LogicalName="webview2/x86/WebView2Loader.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" LogicalName="webview2/arm64/WebView2Loader.dll" />
  </ItemGroup>
</Project>
