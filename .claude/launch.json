{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pusulaHub",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 4242,
      "autoPort": false
    },
    {
      "name": "aktarim-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=services/pusula-aktarim/.env.dev",
        "services/pusula-aktarim/server.js"
      ],
      "port": 5055,
      "autoPort": false
    },
    {
      "name": "notify-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/agent/windows/notify-web", "run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180,
      "autoPort": false
    }
  ],
  "autoVerify": false
}
